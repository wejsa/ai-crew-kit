{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "ai-crew-kit",
  "displayName": "AI Crew Kit",
  "version": "4.7.0",
  "description": "General-purpose AI crew framework for software development process management — agent team orchestration (plan→impl→review→merge) plus a deterministic merge quality gate. 22 skills + 7 agents + quality gate hooks.",
  "author": {
    "name": "wejsa"
  },
  "homepage": "https://github.com/wejsa/ai-crew-kit",
  "repository": "https://github.com/wejsa/ai-crew-kit",
  "license": "MIT",
  "keywords": [
    "workflow",
    "agent-orchestration",
    "process-management",
    "code-review",
    "quality-gate",
    "merge-gate",
    "deterministic",
    "quality-assurance"
  ],
  "skills": "./.claude/skills/",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-start.sh\"",
            "timeout": 30,
            "statusMessage": "git sync + state load"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

{
  "name": "fintech-gateway",
  "description": "핀테크 도메인 API Gateway 서비스",
  "domain": "fintech",
  "version": "1.0.0",
  "kitVersion": "2.0.0",
  "kitSource": "https://github.com/wejsa/ai-crew-kit.git",
  "techStack": {
    "backend": "spring-boot-kotlin",
    "frontend": "none",
    "database": "mysql",
    "cache": "redis",
    "messageQueue": "none",
    "infrastructure": "none"
  },
  "agents": {
    "enabled": ["pm", "backend", "code-reviewer", "qa"],
    "disabled": ["planner", "frontend", "docs", "db-designer", "devops"]
  },
  "conventions": {
    "taskPrefix": "TASK",
    "branchStrategy": "git-flow",
    "commitFormat": "conventional",
    "prLineLimit": 500,
    "testCoverage": 80,
    "language": "ko",
    "skillProfile": "default",
    "overridePriority": "domain-first"
  },
  "hooks": {},
  "tokenHints": {},
  "ports": {
    "app": 10080,
    "db": 3306,
    "cache": 6379
  },
  "metadata": {
    "version": 2,
    "updatedAt": "2026-05-04T00:00:00Z"
  },
  "createdAt": "2026-02-03T00:00:00Z"
